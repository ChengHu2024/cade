# Normalise line endings so the package is identical on every platform.
* text=auto

*.R       text eol=lf
*.Rd      text eol=lf
*.Rmd     text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.Rbuildignore text eol=lf
.gitignore     text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
*.gz  binary
*.rds binary
