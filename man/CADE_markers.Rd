\name{CADE_markers}
\alias{CADE_markers}
\docType{data}
\title{Default marker gene sets}
\format{A named list of character vectors. Each element is a set of gene
symbols for one cell type.}
\usage{CADE_markers}
\description{
A named list of cell-type marker genes used by \code{\link{marker_consistency}}.
These are widely used, canonical markers, not data-derived.
}
\examples{
str(CADE_markers, max.level = 1)
}
\keyword{datasets}
